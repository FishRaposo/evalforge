{
  "name": "evalforge-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build && node e2e/normalize-static-export.mjs",
    "start": "next start -p 3002",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "demo:ui": "cross-env NEXT_PUBLIC_DEMO_MODE=true next dev -p 3002 -H 127.0.0.1",
    "build:connected": "cross-env EVALFORGE_CONNECTED_BUILD=true NEXT_DIST_DIR=dist-connected next build",
    "start:connected": "cross-env EVALFORGE_CONNECTED_BUILD=true NEXT_DIST_DIR=dist-connected next start -H 127.0.0.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.4.2",
    "postcss": "^8.5.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^25.0.0",
    "typescript": "^5.3.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
